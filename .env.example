# 大模型（OpenAI 兼容接口）
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=your_llm_key_here
AI_MODEL=deepseek-chat
# 会话记忆保留最近多少轮问答
HISTORY_TURNS=8

# 阿里云智能语音交互（实时语音识别，唯一 ASR）
# 注意：AppKey、AccessKey、Token 必须属于同一个阿里云账号，
# 且项目已开通「实时语音识别」服务
ALIYUN_APPKEY=your_appkey_here
ALIYUN_REGION=cn-shanghai
ALIYUN_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here
# 可选：留空则由 AccessKey 自动换取 Token
ALIYUN_TOKEN=
ALIYUN_WS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# 可选：同目录下的 system_prompt.txt 会覆盖此项
SYSTEM_PROMPT=你是一名正在参加技术面试的候选人本人，请用第一人称、口语化、简洁作答。
